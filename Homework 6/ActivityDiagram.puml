@startuml
title School Facility Rental - Activity

|Renter|
start
:Choose facility, date, time, and event type;

|Website|
:Check availability;

if (Is facility available?) then ([not available])
  :Tell renter not available;
  |Renter|
  :Choose different date or stop;
  stop
else ([available])
  |Renter|
  :Enter contact info and submit;

  |School Staff|
  :Review request;

  if (Is request approved?) then ([rejected])
    |Website|
    :Record request rejected;

    |Email Service|
    :Send rejection email;
    stop
  else ([approved])
    |Payment Service|
    :Process payment;

    if (Does payment succeed?) then ([payment fails])
      |Website|
      :Record payment failed;

      |Email Service|
      :Send payment failed email;
      stop
    else ([payment succeeds])
      |Website|
      :Save booking;

      |Email Service|
      :Send confirmation email;
      stop
    endif
  endif
endif

@enduml